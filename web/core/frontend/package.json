    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "run-tsc": "tsc -b",
        "typecheck": "tsc -p tsconfig.app.json --tsBuildInfoFile /dev/null && tsc -p tsconfig.node.json --tsBuildInfoFile /dev/null",
