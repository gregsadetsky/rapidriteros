        "tailwindcss": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/js-cookie": "^3.0.6",
        "@types/prismjs": "^1.26.5",
        "@types/react": "^19.0.1",
